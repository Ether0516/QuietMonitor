<Application x:Class="QuietMonitor.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="TextBrush" Color="#EDF1F7"/>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#202B3C"/>
   <Setter Property="Foreground" Value="#EDF1F7"/><Setter Property="BorderBrush" Value="#45566F"/>
   <Setter Property="Padding" Value="12"/><Setter Property="MaxWidth" Value="460"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="16,8"/><Setter Property="Foreground" Value="#EDF1F7"/>
   <Setter Property="Background" Value="#303A4B"/><Setter Property="BorderBrush" Value="#4A566B"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF1F7"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Application.Resources>
</Application>
