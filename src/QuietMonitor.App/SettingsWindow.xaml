<Window x:Class="QuietMonitor.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Quiet Monitor · 设置" Width="470" Height="650"
 MinWidth="430" MinHeight="550" Background="#161C27" Foreground="#EDF1F7" WindowStartupLocation="CenterScreen"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" ResizeMode="CanResize">
 <Grid Margin="28,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20">
   <TextBlock Text="Quiet Monitor" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="CPU / GPU，安静地留在桌面。" Foreground="#9EAEC4" Margin="0,5,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock Text="外观" Foreground="#96B7E9" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <Grid><TextBlock Text="背景不透明度"/><TextBlock x:Name="OpacityLabel" HorizontalAlignment="Right" Foreground="#9EAEC4"/></Grid>
    <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,8,0,16"/>
    <Grid><TextBlock Text="字号"/><TextBlock x:Name="FontLabel" HorizontalAlignment="Right" Foreground="#9EAEC4"/></Grid>
    <Slider x:Name="FontSlider" Minimum="12" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,22"/>
    <TextBlock Text="采样" Foreground="#96B7E9" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
     <TextBlock Text="刷新间隔" VerticalAlignment="Center"/>
     <ComboBox x:Name="IntervalBox" Grid.Column="1" Padding="8,5" Foreground="#202938">
      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="#202938"/></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
    </Grid>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
     <TextBlock Text="监控显卡" VerticalAlignment="Center"/>
     <ComboBox x:Name="GpuBox" Grid.Column="1" Padding="8,5" Foreground="#202938">
      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#202938"/></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
    </Grid>
    <CheckBox x:Name="TopmostBox" Content="始终置顶" Margin="0,0,0,12"/>
    <CheckBox x:Name="LockBox" Content="锁定位置并让鼠标穿透" Margin="0,0,0,10"/>
    <TextBlock Text="穿透后可通过托盘菜单或恢复快捷键解除。" Foreground="#9EAEC4" FontSize="12" Margin="20,0,0,18"/>
    <Border Background="#222C3B" CornerRadius="8" Padding="13" Margin="0,0,0,16">
     <StackPanel><TextBlock Text="Ctrl + Alt + M                 显示 / 隐藏" FontSize="12"/>
      <TextBlock Text="Ctrl + Alt + Shift + M      显示并解除穿透" FontSize="12" Margin="0,6,0,0"/>
      <TextBlock x:Name="HotkeyStatus" Foreground="#E6BE80" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
     </StackPanel>
    </Border>
    <Expander Header="采样状态与诊断" Foreground="#9EAEC4" Margin="0,0,0,15">
     <TextBox x:Name="Diagnostics" IsReadOnly="True" TextWrapping="Wrap" Background="#111721" Foreground="#B8C8DE"
      BorderThickness="0" Padding="10" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="190"/>
    </Expander>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button Content="恢复位置" Click="ResetPosition" HorizontalAlignment="Left" Padding="10,8"/>
   <Button Grid.Column="1" Content="取消" Click="Cancel" Margin="8,0"/>
   <Button Grid.Column="2" Content="保存" Click="Save" Background="#3B5F8C" BorderBrush="#688CBD" IsDefault="True"/>
  </Grid>
 </Grid>
</Window>
